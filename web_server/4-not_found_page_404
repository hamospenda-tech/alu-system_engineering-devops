#!/usr/bin/env bash
# Install and configure nginx with redirection and a custom 404 page.
set -e
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y nginx
apt-get install -y curl
mkdir -p /var/www/html
printf '%s\n' 'Holberton School for the win!' > /var/www/html/index.html
printf '%s\n' "Ceci n'est pas une page" > /var/www/html/404.html
cat > /etc/nginx/sites-available/default <<'NGINX'
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    root /var/www/html;
    index index.html;
    server_name _;
    location / {
        try_files $uri $uri/ =404;
    }
    location ~ ^/redirect_me/?$ {
        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;
    }
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
NGINX
ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default
nginx -t
service nginx restart
status=$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' http://127.0.0.1/)
[ "$status" = 200 ] || { echo "Homepage check failed: expected HTTP 200, got $status" >&2; exit 1; }
curl --fail --silent --show-error http://127.0.0.1/ | grep -F 'Holberton School'
status=$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' http://127.0.0.1/redirect_me)
[ "$status" = 301 ] || { echo "Redirect check failed: expected HTTP 301, got $status" >&2; exit 1; }
status=$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' http://127.0.0.1/alu-missing-page-check)
[ "$status" = 404 ] || { echo "404 check failed: expected HTTP 404, got $status" >&2; exit 1; }
curl --silent --show-error http://127.0.0.1/alu-missing-page-check | grep -F "Ceci n'est pas une page"
echo 'Local HTTP checks passed. Verify the web01 public IP from another computer before requesting review.'
